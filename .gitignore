# The book itself, and its snapshots. Backed up by pg_dump-equivalent, not by git.
anansi.db
anansi.db-wal
anansi.db-shm
backups/

# Measurement output — reproducible by re-running the bench scripts.
bench/results.json
bench/*.log

node_modules/

# Where uploads land before they are read. safePath() mkdirs it, so nothing needs it tracked —
# and a 100-byte huge.db got committed from a test run before this line existed.
imports/

# Who may write, and where the server listens. Two real people's addresses, and the only copy
# of the allowlist — it lived in a run command until 2026-08-26, which meant a reboot silently
# took the second writer away. Read by `node --env-file` and by anansi.service alike.
.env
# AND EVERY COPY OF IT. `.env.bak` appeared on 2026-08-27 from a command that edited the
# allowlist and backed the file up first — untracked, unignored, and one `git add -A` from
# being published with the tailnet allowlist in it. A pattern rather than a name, because the
# next copy will be called something else.
.env.*
